# ─────────────────────────────────────────────────────────────
# AI 模型服务（服务端读取，绝不下发到浏览器）
# 兼容任何 OpenAI 协议的端点：OpenAI / DeepSeek / 通义 / Kimi / 智谱 / 火山方舟 / Ollama / vLLM / LM Studio
#
# 说明：多模型配置在「设置 → 模型服务」里管理，存在本地数据库，优先级高于这里的变量。
#      这里的变量只在数据库里一套模型都没有时作为兜底（适合容器/无界面部署）。
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=openai            # openai | anthropic
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=                   # 留空则在「设置」页填写，或在此填入
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.6
AI_TIMEOUT_MS=120000
AI_MAX_TOKENS=4000

# 数据与上传
DATA_DIR=./data
MAX_UPLOAD_MB=20

# 单用户本地模式下的访问口令（留空=不校验；公网部署时务必填写）
# APP_ACCESS_TOKEN=
